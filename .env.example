# ══════════════════════════════════════════════════════════════
# Prompt2App 环境变量示例 —— 复制为 .env 后按需填写
# 注意: .env 已被 .gitignore 排除，切勿提交到仓库
# 不配 Key 也能完整跑通：四层容灾自动落入 L4 离线演示模式
# ══════════════════════════════════════════════════════════════

# ── 服务 ──────────────────────────────────────────────────────
# 监听端口（默认 8000；main.py 与 Dockerfile 均读取此变量）
# PORT=8000

# SQLite 数据库文件路径（默认 ./app.db；Docker 部署建议挂卷）
# APP_DB_PATH=./app.db

# 智能体全局 LLM 并发上限（默认 5，防止触发上游 429）
# MAX_CONCURRENT_LLM=5

# 会话产物文件存储根目录（默认 ./.data；含每用户/每会话文件夹）
# P2A_DATA_DIR=./.data

# ── L2 主通道：Kimi 官方 ──────────────────────────────────────
# 控制台: https://platform.moonshot.cn （中国站，与国际站 Key 不通用）
KIMI_API_KEY=
# 兼容官方命名，二选一即可
# MOONSHOT_API_KEY=
# 端点（默认 https://api.moonshot.cn/v1）
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# 显式模型覆盖（须存在于官方 GET /v1/models 列表，否则自动回退优选）
# KIMI_MODEL=kimi-k3

# ── L3 备用通道：硅基流动 SiliconFlow ─────────────────────────
# 控制台: https://cloud.siliconflow.cn
# 依据其官方文档适配：max_tokens 字段、厂商/模型名 ID、无 prompt_cache_key
BACKUP_API_KEY=
# 端点（默认 https://api.siliconflow.cn/v1；可指向 DeepSeek 官方等任意 OpenAI 兼容端点）
# BACKUP_BASE_URL=https://api.siliconflow.cn/v1
# 显式模型覆盖（如 deepseek-ai/DeepSeek-V4-Flash）
# BACKUP_MODEL=
